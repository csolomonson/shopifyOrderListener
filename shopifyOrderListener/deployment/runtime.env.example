APP_VERSION=development
SALES_ORDER_AUTH_REQUIRED=true
SALES_ORDER_STARTUP_SYNC=true
SALES_ORDER_BACKGROUND_SYNC=true
SALES_ORDER_STORAGE_MODE=sql
SALES_ORDER_DB_SERVER=MEZIEREDB22.example.internal,1433
SALES_ORDER_DB_USERNAME=sales_order_app
SALES_ORDER_DB_DRIVER=ODBC Driver 18 for SQL Server
SALES_ORDER_DB_TRUST_SERVER_CERTIFICATE=false
SALES_ORDER_DB_PASSWORD_FILE=/var/lib/shopify-order-listener/secrets/db_password.txt
SALES_ORDER_USERNAME=administrator
SALES_ORDER_PASSWORD_FILE=/var/lib/shopify-order-listener/secrets/app_password.txt
SALES_ORDER_SESSION_SECRET_FILE=/var/lib/shopify-order-listener/secrets/session_secret.txt
SHOPIFY_SHOP=replace-with-shop-subdomain
SHOPIFY_CLIENT_ID=replace-after-rotating
SHOPIFY_CLIENT_SECRET_FILE=/var/lib/shopify-order-listener/secrets/shopify_client_secret.txt
SHOPIFY_API_VERSION=2026-07
M1_API_BASE_URL=http://replace-with-m1-host:1937
M1_API_ID=replace-after-rotating
M1_API_KEY_FILE=/var/lib/shopify-order-listener/secrets/m1_api_key.txt
M1_WRITES_ENABLED=false
M1_DEFAULT_WAREHOUSE=142
M1_DEFAULT_BIN=BIN1
M1_DEFAULT_UOM=EA
